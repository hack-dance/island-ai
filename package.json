{
  "name": "island-ai",
  "private": true,
  "scripts": {
    "build": "turbo run build --concurrency=11",
    "dev": "turbo dev --concurrency=11",
    "docs": "turbo dev --filter=docs",
    "lint": "turbo lint --concurrency=11",
    "type-check": "turbo type-check --concurrency=11",
    "test:packed": "bash tests/packed-consumer/verify.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:write": "prettier --write \"**/*.{js,json,jsx,ts,tsx}\"",
    "start": "turbo run start --filter=docs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "turbo run build --filter='./public-packages/*' && changeset publish",
    "sync-ls": "syncpack lint --specifier-types exact,range",
    "sync-up": "syncpack fix --specifier-types exact,range"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.4.3",
    "husky": "^8.0.3",
    "prettier": "^3.9.10",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.10"
  },
  "overrides": {
    "@babel/helpers": "7.29.10",
    "@babel/runtime": "7.29.10",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.6",
    "diff": "^5.2.2",
    "engine.io": "6.6.11",
    "estree-util-value-to-estree": "^3.5.0",
    "flatted": "3.4.4",
    "form-data": "^4.0.6",
    "lodash": "^4.18.1",
    "micromatch": "^4.0.8",
    "nanoid": "3.3.20",
    "postcss": "8.5.31",
    "socket.io-adapter": "^2.5.8",
    "socket.io-parser": "4.2.7",
    "yaml": "2.9.1",
    "next": "16.4.2",
    "esbuild": "0.28.2",
    "postcss-selector-parser": "7.1.6",
    "serialize-javascript": "7.0.5",
    "image-size": "2.0.3",
    "toml": "4.2.0",
    "uuid": "11.1.1",
    "ajv": "6.14.0",
    "glob": "10.5.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.22.1"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "public-packages/*"
  ]
}
